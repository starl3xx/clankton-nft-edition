# =============================================================================
# Environment Variables for Clankton NFT Mini App
# =============================================================================
# Copy this file to .env.local and fill in the values
#
# For Vercel deployment, set these in your Vercel project settings:
# https://vercel.com/docs/environment-variables
# =============================================================================

# -----------------------------------------------------------------------------
# Neynar API (Required)
# -----------------------------------------------------------------------------
# Get your API key from https://neynar.com
# Used for: Follow verification, Farcaster Pro detection, channel membership
NEYNAR_API_KEY=

# -----------------------------------------------------------------------------
# EIP-712 Signature Signer (Required for minting)
# -----------------------------------------------------------------------------
# Private key of the wallet that signs mint requests
# This wallet address must be set as the "signer" in the smart contract
# IMPORTANT: Keep this secret! Never commit the actual key.
SIGNER_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Smart Contract (Required)
# -----------------------------------------------------------------------------
# The deployed NFT contract address on Base mainnet (chain ID: 8453)
# Example: 0x1234...abcd
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=

# -----------------------------------------------------------------------------
# Admin Authentication (Required for notifications)
# -----------------------------------------------------------------------------
# Secret token for triggering notifications via /api/notifications/trigger
# Use a strong random string (e.g., openssl rand -hex 32)
ADMIN_SECRET=

# -----------------------------------------------------------------------------
# Vercel Postgres (Auto-configured on Vercel)
# -----------------------------------------------------------------------------
# These are automatically set when you link a Vercel Postgres database
# For local development, you can get connection strings from your Vercel dashboard
#
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# -----------------------------------------------------------------------------
# Vercel KV / Redis (Auto-configured on Vercel)
# -----------------------------------------------------------------------------
# These are automatically set when you link a Vercel KV store
# Used for rate limiting
#
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
